# dsh-laodi 示例环境变量
#
# 用法：复制为 .env 后填写（.env 已被 .gitignore 忽略，切勿提交真实密钥）。
#   copy .env.example .env
#   node --env-file=.env src/index.mjs
#
# 不填也能跑：
#   - 本机已装 DSH + Magpie 时，会自动读 ~/.dsh 里的网关配置
#   - 都没有时视觉调用自动降级为 mock

# 视觉模型接口地址（OpenAI 兼容：<baseURL>/chat/completions）
# 复用 DSH Magpie 网关时用下面这组：
DSH_VISION_BASE_URL=http://127.0.0.1:3425/v1

# 视觉模型名（需支持多模态输入；Magpie 实测可用）：
#   deepseek/deepseek-flash
#   minimax-cn/MiniMax-M3.1-Flash
DSH_VISION_MODEL=deepseek/deepseek-flash

# API Key —— Magpie 本地网关一般是 magpie；也可用 MAGPIE_GATEWAY_KEY
DSH_VISION_API_KEY=magpie

# 强制 mock 视觉输出（1/true 开启；调试宿主循环时很好用）
DSH_VISION_MOCK=0

# 插件数据目录（设置落盘位置），留空则用 %LOCALAPPDATA%\dsh-laodi
# DSH_LAODI_DATA_DIR=

# 全局热键（文案占位）
# DSH_HOTKEY_ASK=Ctrl+Shift+Space
# DSH_HOTKEY_CALIBRATE=Ctrl+Shift+D
# DSH_HOTKEY_TOGGLE=Ctrl+Shift+O
